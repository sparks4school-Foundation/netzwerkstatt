{
  "format": "netzwerkstatt",
  "version": 1,
  "stufe": "7-8",
  "titel": "Schulnetz mit Webserver und DNS",
  "geraete": [
    {
      "id": "g1",
      "typ": "computer",
      "name": "Computer 1",
      "position": { "x": 0, "y": 0 },
      "ip": "192.168.0.10",
      "dnsServer": "192.168.0.3",
      "dienste": [{ "art": "browser" }]
    },
    {
      "id": "g2",
      "typ": "computer",
      "name": "Computer 2",
      "position": { "x": 0, "y": 240 },
      "ip": "192.168.0.11",
      "dnsServer": "192.168.0.3",
      "dienste": [{ "art": "browser" }]
    },
    { "id": "g3", "typ": "switch", "name": "Switch", "position": { "x": 260, "y": 120 } },
    {
      "id": "g4",
      "typ": "server",
      "name": "Webserver-Rechner",
      "position": { "x": 540, "y": 0 },
      "ip": "192.168.0.2",
      "dienste": [
        {
          "art": "webserver",
          "seiten": [
            {
              "pfad": "/",
              "html": "<h1>Willkommen auf der Schul-Website</h1>\n<p>Diese Seite liegt auf dem Webserver mit der IP-Adresse 192.168.0.2.</p>\n<p><a href=\"/stundenplan.html\">Zum Stundenplan</a></p>\n"
            },
            {
              "pfad": "/stundenplan.html",
              "html": "<h1>Stundenplan</h1>\n<ul>\n  <li>Montag: Informatik</li>\n  <li>Dienstag: Mathematik</li>\n</ul>\n<p><a href=\"/\">Zurück zur Startseite</a></p>\n"
            }
          ]
        }
      ]
    },
    {
      "id": "g5",
      "typ": "server",
      "name": "DNS-Rechner",
      "position": { "x": 540, "y": 240 },
      "ip": "192.168.0.3",
      "dienste": [
        { "art": "dns-server", "eintraege": [{ "domain": "www.schule.test", "ip": "192.168.0.2" }] }
      ]
    }
  ],
  "leitungen": [
    { "id": "l1", "art": "kabel", "von": "g1", "nach": "g3" },
    { "id": "l2", "art": "kabel", "von": "g2", "nach": "g3" },
    { "id": "l3", "art": "kabel", "von": "g4", "nach": "g3" },
    { "id": "l4", "art": "kabel", "von": "g5", "nach": "g3" }
  ]
}
