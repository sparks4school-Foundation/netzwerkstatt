    {
      "id": "l4",
      "art": "kabel",
      "von": "g5",
      "nach": "g3"
    }
  ],
  "aufgabe": {
    "titel": "Schulnetz mit Webserver und DNS",
    "auftrag": "Öffne auf Computer 1 den Browser und rufe www.schule.test auf. Beobachte im Protokoll: Wen fragt der Computer zuerst – und warum? Schalte danach auf die Ansicht „Dienste“.",
    "hilfen": [
      "Wähle Computer 1 aus und tippe im Modus „Ausprobieren“ auf „Browser öffnen“.",
      "Im Protokoll steht zuerst eine DNS-Anfrage. An welche IP-Adresse geht sie?"
    ],
    "aufbauGesperrt": false,
    "blackbox": [],
    "pruefungen": [
      {
        "art": "webseite",
        "geraetId": "g1",
